# ---------------------------------------------------------------------------
# Jais Arabic Voice Chatbot — environment template (copy to .env)
#

# --- Speech-to-text: Jais-ASR ----------------------------------------------
# "auto" picks: IFM/Jais-ASR (fp16, ~11.4 GB) when >= 20 GB VRAM is free,
# otherwise IFM/Jais-ASR-W4A16-AWQ (~3.4 GB, needs compressed-tensors) for
# 16 GB GPUs like the Colab T4.
JAIS_ASR_MODEL=auto
# fp16 | bf16 | fp32 | auto   (T4 has no bf16; "auto" resolves to fp16)
JAIS_ASR_DTYPE=auto
JAIS_ASR_DEVICE=cuda
# Drop audio beyond this length from each VAD speech segment (seconds).
JAIS_ASR_MAX_SEGMENT_SECS=35
JAIS_ASR_MAX_NEW_TOKENS=256

# --- Chat LLM: Jais-3 ------------------------------------------------------
# Card default is reasoning_effort="high" for best quality; "low" (no
# reasoning) is our interpretation for low-latency voice. Override freely.
JAIS_LLM_MODEL=inception42/Jais-3-0.9B
JAIS_LLM_DTYPE=fp16
JAIS_LLM_DEVICE=cuda
JAIS_LLM_REASONING_EFFORT=low
JAIS_LLM_TEMPERATURE=0.2
JAIS_LLM_TOP_P=0.95
JAIS_LLM_TOP_K=20
JAIS_LLM_REPETITION_PENALTY=1.0
JAIS_LLM_MAX_NEW_TOKENS=200
JAIS_LLM_MAX_CONTEXT_MESSAGES=16

# Persona (Arabic). Leave unset to use the built-in defaults.
#JAIS_SYSTEM_PROMPT=أنت مساعد صوتي عربي ودود...
#JAIS_INTRO_PROMPT=قدّم نفسك باختصار ومرحّباً المستخدم.

# --- Text-to-speech: Audar-TTS-V1-Flash + NeuCodec -------------------------
# Voice: one of demo_female_1..3 / demo_male_1..3, or "custom".
JAIS_TTS_VOICE=demo_female_1
# For voice = custom, provide BOTH:
#JAIS_TTS_REF_WAV=/path/to/reference.wav      # 5-15 s clean clip
#JAIS_TTS_REF_TEXT=نص الرسالة المرجعية نفسها
# The built-in demo clips ship without transcripts; we bootstrap the transcript
# by transcribing the clip with the loaded Jais-ASR at startup.
JAIS_TTS_REF_TRIM_SECS=12
JAIS_TTS_TEMPERATURE=0.7
JAIS_TTS_TOP_K=40
JAIS_TTS_TOP_P=0.9
JAIS_TTS_REPETITION_PENALTY=1.1
JAIS_TTS_MAX_NEW_TOKENS=1500
JAIS_TTS_MIN_NEW_TOKENS=50
JAIS_TTS_CHUNK_SECS=0.25

# --- Pipeline audio rates --------------------------------------------------
JAIS_SAMPLE_RATE_IN=16000    # == Jais-ASR native
JAIS_SAMPLE_RATE_OUT=24000   # == Audar-TTS native
